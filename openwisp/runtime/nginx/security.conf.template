# Package-owned policy: upstream's positive HSTS breaks HTTP on other ports.
add_header X-XSS-Protection "1; mode=block" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Permissions-Policy "interest-cohort=()" always;
add_header Strict-Transport-Security ${DOLLAR}openwisp_hsts_recovery always;
add_header Content-Security-Policy "default-src http: https: data: blob: 'unsafe-inline'; script-src 'unsafe-eval' https: 'unsafe-inline' 'self'; frame-ancestors 'self'; connect-src ${ORIGINS} wss: 'self'; worker-src https://${DOMAIN} blob: 'self';" always;
